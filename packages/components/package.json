{
  "name": "@1001-digital/components",
  "version": "2.10.3",
  "type": "module",
  "main": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./client-only": "./src/client-only.ts",
    "./base/icons": "./src/base/icons.ts",
    "./base/link": "./src/base/link.ts",
    "./*": "./src/*"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "pnpm test:utils && pnpm test:components",
    "test:components": "vitest run",
    "test:utils": "node --test test/*.test.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@1001-digital/styles": "workspace:^",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@internationalized/date": "^3.12.3",
    "@visualizevalue/opepicons": "^1.0.0",
    "@vueuse/core": "^14.4.0",
    "luxon": "^3.7.2",
    "reka-ui": "^2.10.3"
  },
  "devDependencies": {
    "@testing-library/user-event": "^14.6.5",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.10.9",
    "@types/luxon": "^3.7.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vitest-axe": "0.1.0",
    "vitest-canvas-mock": "^0.3.3",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.10"
  }
}
